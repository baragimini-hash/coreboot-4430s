# SPDX-License-Identifier: GPL-2.0-or-later
#
# HP ProBook 4430s -- DERIVED FROM hp/2560p (Sandy Bridge / 6-series PCH /
# KBC1126 EC). The 4430s is HM65 (6-series, no vPro), 4 MB SPI, 14" LVDS.
# GPIOs/audio verb are inherited from 2560p as a FIRST BOOT starting point and
# almost certainly need adjustment against the 4430s boardview/schematic.
# Target CPU for this port: Ivy Bridge (Gen3) on HM65. No pinmod is needed --
# the ref_test4 recovery v1 ROM already POSTs an i5 Ivy Bridge on this
# HM65 board unmodified (the chipset accepts IVB at stock strapping).
# coreboot supplies the 306A9 microcode natively.

chip northbridge/intel/sandybridge
	register "gpu_cpu_backlight" = "0x00000155"
	register "gpu_pch_backlight" = "0x02880288"

	device domain 0 on
		# FIXME: 0x103c/0x1631 is the most likely 4430s subsystem ID; verify via
		# `biosdecode`/`dumpiod` from the vendor BIOS or the DMI table.
		subsystemid 0x103c 0x1631 inherit

		device ref peg10 off end
		device ref igd on  end

		chip southbridge/intel/bd82x6x # Intel Series 6 Cougar Point PCH
			# mailbox at 0x200/0x201 and PM1 at 0x220.
			# IMPORTANT: these are packed uint32_t hardware register values
			# (Intel PCH GEN_DEC encoding: base | (size<<16) | enable), NOT
			# LPC_IO(...) brace-initializer macros. The generated static.c
			# does NOT include the BD82X6X chip header, so LPC_IO resolves
			# to an undeclared function -> "initializer element is not
			# constant" -> the build dies ~15 min in on gen3/gen4. Values
			# inherited from upstream hp/2560p (same 6-series PCH family,
			# same KBC1126 EC I/O footprint) and good enough for a first
			# boot. Tune against the 4430s boardview later if a specific
			# port isn't decoding right.
			register "gen1_dec" = "0x007c0201"
			register "gen2_dec" = "0x000c0101"
			register "gen3_dec" = "0x00fcfe01"
			register "gen4_dec" = "0x000402e9"
			register "gpi6_routing" = "2"
			register "pcie_hotplug_map" = "{ 0, 1, 0, 0, 0, 0, 0, 0 }"
			# HDD(0), ODD(1), eSATA(4), dock eSATA(5)
			register "sata_port_map" = "0x33"

			register "usb_port_config" = "{
				{1, 1, 0}, /* back bottom USB port, USB debug */
				{1, 1, 0}, /* back upper USB port */
				{1, 1, 1}, /* eSATA */
				{1, 1, 1}, /* webcam */
				{1, 0, 2},
				{1, 0, 2}, /* bluetooth */
				{1, 0, 3},
				{1, 0, 3}, /* smartcard */
				{1, 1, 4}, /* fingerprint reader */
				{1, 1, 4}, /* WWAN */
				{0, 0, 5},
				{1, 0, 5}, /* docking */
				{0, 0, 6},
				{0, 0, 6}
			}"

			device ref pcie_rp1 off end
			device ref pcie_rp2 on
				smbios_slot_desc "SlotTypePcmcia" "SlotLengthShort"
					"ExpressCard Slot" "SlotDataBusWidth1X"
			end
			device ref pcie_rp3 on  end # SD/MMC Host Controller
			device ref pcie_rp4 on      # WLAN
				smbios_slot_desc "SlotTypePciExpressMini52pinWithoutBSKO"
					"SlotLengthShort" "Mini PCIe" "SlotDataBusWidth1X"
			end
			device ref pcie_rp5 off end
			device ref pcie_rp6 off end
			device ref pcie_rp7 on      # WWAN
				smbios_slot_desc "SlotTypePciExpressMini52pinWithoutBSKO"
					"SlotLengthLong" "Mini PCIe" "SlotDataBusWidth1X"
			end
			device ref pcie_rp8 off end
			device ref lpc on
				chip ec/hp/kbc1126
					register "ec_data_port" = "0x60"
					register "ec_cmd_port"  = "0x64"
					register "ec_ctrl_reg"  = "0xca"
					register "ec_fan_ctrl_value" = "0x6b"
					device pnp ff.1 off end
				end
			end
		end
	end
end
