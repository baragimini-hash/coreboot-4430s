# coreboot .config for HP ProBook 4430s
# (Ivy Bridge Gen3 on HM65, 4 MB SPI, KBC1126 EC)
#
# Most options (EC, native raminit, libgfxinit, microcode, 4 MB ROM size)
# are auto-selected by CONFIG_BOARD_HP_4430S. Run `make nconfig` afterwards
# to review / change the payload.

# Select the HP vendor menu FIRST. Without CONFIG_VENDOR_HP=y the board
# symbol below lives inside an invisible `if VENDOR_HP` block, so `make
# olddefconfig` drops it and the vendor choice silently falls back to
# CONFIG_VENDOR_EMULATION (QEMU) -- which builds a ROM that POSTs nothing on
# real HM65 hardware.
CONFIG_VENDOR_HP=y
CONFIG_BOARD_HP_4430S=y

# Set VARIANT_DIR explicitly so Make can resolve variants/$(VARIANT_DIR)/...
# at build time. (The Kconfig OVERRIDE_DEVICETREE escapes the $ so Make does
# the expansion; we belt-and-suspender it here in case the Kconfig default
# chain ever runs into an evaluation-order race.)
CONFIG_VARIANT_DIR="4430s"

# Pull in 3rdparty blobs (Intel microcode for 306A9, KBC1126 EC blobs)
CONFIG_USE_BLOBS=y

# Payload: EDK2 / Tianocore (UEFI). Boots UEFI-installed OSes
# (Windows 10/11 UEFI, Linux with systemd-boot/grub-efi). We use this instead
# of SeaBIOS because the OS is installed UEFI and legacy SeaBIOS black-screened
# at boot (TEST4 notes: "UEFI-only flashdisk cannot boot under SeaBIOS").
CONFIG_PAYLOAD_EDK2=y

# Useful for bring-up on a bricked machine -- keep early debug output.
CONFIG_CONSOLE_CBMEM=y
# POST codes to port 0x80 (diagnostic POST-card). Enabled because you want to
# see whether the board POSTs; it does NOT affect powering on.
CONFIG_POST_IO=y

# Maximize the CBFS so the ~1.5 MB EDK2/UEFI payload actually fits on the
# 4 MB ROM. The 4430s southbridge (bd82x6x) selects INTEL_DESCRIPTOR_MODE_CAPABLE
# which forces HAVE_INTEL_FIRMWARE=y; that symbol's default CBFS_SIZE (0x100000)
# -- combined with the sandybridge northbridge default -- leaves the COREBOOT
# region at only ~444 KB, far too small for EDK2, so the build fails at
# "Could not add build/UEFIPAYLOAD.fd ... Largest empty slot: 144320". Override
# it here with a flat 4 MB layout (no IFD/ME region) where the whole ROM minus
# the bootblock is CBFS. This matches the known-good flat TEST4 recovery ROM,
# which also POSTs Ivy Bridge with no ME region.
CONFIG_CBFS_SIZE=0x3C0000
